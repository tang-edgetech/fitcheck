# The repository folder sits inside public_html (public_html/fitcheck.smartsitecp.com, a git clone).
# Only these are meant for the web, each through its own subdomain:
#   fitcheck.smartsitecp.com      → document root frontend/      (frontend/.htaccess serves the built site in frontend/out/)
#   fitcheck-api.smartsitecp.com  → document root backend/public (protected further by backend/.htaccess)
# Everything else answers 404. Apache applies this file to the subfolders too; the patterns only match
# paths that no page of the site or the API uses.

# Never list folder contents (e.g. frontend/ before the Node.js app is connected shows 403, not "Index of")
Options -Indexes

<IfModule mod_alias.c>
    # Git history, deploy settings (Telegram token), docs — from any address
    RedirectMatch 404 /(\.git|\.claude|deploy|docs)(/|$)
    # The repo's folders reached through another domain (e.g. smartsitecp.com/fitcheck.smartsitecp.com/backend/…)
    RedirectMatch 404 /(frontend|backend)(/|$)
    RedirectMatch 404 /(README\.md|\.gitignore|\.gitattributes)$

    # fitcheck.smartsitecp.com has frontend/ as its document root: keep the source and the built files private.
    # Next.js itself serves every page, /_next/… and the files from public/ (e.g. /help/…).
    RedirectMatch 404 ^/(src|scripts|public|dist-cpanel|node_modules|\.next|tmp)(/|$)
    RedirectMatch 404 ^/(package\.json|package-lock\.json|tsconfig\.json|next\.config\.ts|next-env\.d\.ts|eslint\.config\.mjs|postcss\.config\.mjs|AGENTS\.md|fitcheck-frontend\.zip|stderr\.log)$
</IfModule>
