# Fitcheck deploy + watchdog settings.
# Copy to deploy/deploy.env on the server (it is git-ignored) and fill in. Paths are for cPanel user cpadmin99.

# ---- Source (a git clone of the repository on the server) ----
SRC_DIR=/home/cpadmin99/fitcheck-src                 # outside public_html, so the source is never on the web
GIT_BRANCH=main

# ---- Where the apps run (see docs/DEPLOY-CPANEL.md) ----
# the repo's backend/ (Laravel); fitcheck-api.smartsitecp.com's document root is API_DIR/public
API_DIR=/home/cpadmin99/public_html/fitcheck.smartsitecp.com/backend
# the BUILT frontend/ (server.js…); Setup Node.js App "Application root" and fitcheck.smartsitecp.com's document root
WEB_DIR=/home/cpadmin99/public_html/fitcheck.smartsitecp.com/frontend
# same folder, relative to the home directory (used to restart the app)
WEB_APP_ROOT=public_html/fitcheck.smartsitecp.com/frontend

# ---- Public addresses ----
SITE_URL=https://fitcheck.smartsitecp.com
API_URL=https://fitcheck-api.smartsitecp.com

# ---- Tools (check with: ls /opt/cpanel/  and  ls ~/nodevenv/) ----
PHP_BIN=/opt/cpanel/ea-php83/root/usr/bin/php
# Composer run WITH PHP 8.3 (the default php on the server may be older). Check the composer path with: which composer
COMPOSER_BIN="/opt/cpanel/ea-php83/root/usr/bin/php /usr/local/bin/composer"
# Activates the Node.js version cPanel created for the app (gives node and npm for building)
NODE_ACTIVATE=/home/cpadmin99/nodevenv/public_html/fitcheck.smartsitecp.com/frontend/22/bin/activate

# 1 = build and install the site on the server. 0 = only deploy the API (if the host kills `next build`
# for using too much memory; then build the site on your computer with npm run build:cpanel and upload it).
DEPLOY_SITE=1

# ---- Telegram (group with topics) ----
# Bot token from @BotFather; chat id of the group (starts with -100); thread id of the topic (leave empty for General)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
# Optional: a different topic for deploy messages (defaults to TELEGRAM_THREAD_ID)
TELEGRAM_DEPLOY_THREAD_ID=

# ---- Watchdog thresholds ----
SSL_WARN_DAYS=14
DISK_WARN_PCT=90
# Alert only after this many failed checks in a row (cron every 5 min × 2 = 10 min), to avoid false alarms
FAIL_THRESHOLD=2
HTTP_TIMEOUT=20

# Where scripts keep their state and logs
STATE_DIR=/home/cpadmin99/fitcheck-deploy-state
