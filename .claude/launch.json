{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "php",
      "runtimeArgs": ["backend/artisan", "serve", "--port=8000", "--no-reload"],
      "port": 8000
    },
    {
      "name": "frontend-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "start", "--", "--port", "3000"],
      "port": 3000
    },
    {
      "name": "frontend-static",
      "runtimeExecutable": "node",
      "runtimeArgs": ["frontend/scripts/serve-static.mjs", "frontend/out", "5050"],
      "port": 5050
    }
  ]
}
