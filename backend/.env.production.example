# Fitcheck API — production settings for cPanel (fitcheck-api.smartsitecp.com)
# Copy to .env on the server, fill in every <…> value, then run the commands in docs/DEPLOY-CPANEL.md.

APP_NAME=Fitcheck
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://fitcheck-api.smartsitecp.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily,database
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
# The database log keeps everything from this level up; Settings > Log picks the real level.
LOG_DB_LEVEL=debug

# cPanel > MySQL Databases. cPanel prefixes names with your account, e.g. smartsit_fitcheck.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<cpaneluser>_fitcheck
DB_USERNAME=<cpaneluser>_fitcheck
DB_PASSWORD=<database password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leave empty: the session cookie belongs to fitcheck.smartsitecp.com (the browser never talks to the API host).
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@smartsitecp.com"
MAIL_FROM_NAME="${APP_NAME}"

# Fitcheck
FRONTEND_URL=https://fitcheck.smartsitecp.com
# Sign-in cookies are only accepted from requests made by this site
SANCTUM_STATEFUL_DOMAINS=fitcheck.smartsitecp.com
# The Next.js app reaches this API through the server's own IP. Put that IP here
# (cPanel > General Information > Shared IP Address), so visitors' real IPs reach the audit log and lockouts.
TRUSTED_PROXIES=<server IP>,127.0.0.1,::1
# Starting password for dev-admin, dev-admin-1 and super-admin. Use a strong one-off value before seeding;
# each account must change it on first sign-in. Remove it from this file afterwards.
DEFAULT_ADMIN_PASSWORD=<strong temporary password>
